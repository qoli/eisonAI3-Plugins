{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qoli/eisonAI3-Plugins/protocol/schema/plugin-manifest.schema.json",
  "title": "eisonAI3 plugin manifest draft v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "protocolVersion",
    "revision",
    "allowedOrigins",
    "collections",
    "capabilities"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "protocolVersion": { "const": 0 },
    "revision": { "type": "string", "minLength": 1 },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://" }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["favorite", "like"] }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSavedAt", "resumableCursor", "detailNavigation", "orderedMedia"],
      "properties": {
        "sourceSavedAt": { "type": "boolean" },
        "resumableCursor": { "type": "boolean" },
        "detailNavigation": { "type": "boolean" },
        "orderedMedia": { "type": "boolean" }
      }
    }
  }
}
